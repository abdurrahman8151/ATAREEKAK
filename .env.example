# ============================================================
# SyRide — environment template.
#
#   cp .env.example .env   then fill in real values.
#
# .env is git-ignored and must never be committed. This template lists the
# variables docker-compose.yml REQUIRES; it intentionally contains no real
# credentials.
#
# The compose file uses the `${VAR:?...}` form for every secret, so
# `docker compose up` HARD-FAILS with a named error when one is missing. That is
# deliberate: it replaces a previous literal `secret` default that silently made
# every deployment use a publicly known password.
# ============================================================

APP_NAME=SyRide
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=

# --- Database (required by the `mysql` / `mysql_replica` services) -----------
# MYSQL_ROOT_PASSWORD: the MySQL root password. REQUIRED — compose will refuse
#   to start without it. Generate a strong random value, e.g.
#     openssl rand -base64 32
MYSQL_ROOT_PASSWORD=

# DB_PASSWORD: the password for the application's own database user. REQUIRED.
#   Prefer a non-root, least-privilege user (DB_USERNAME below).
DB_PASSWORD=

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=4th_year_project_db
DB_USERNAME=

# --- Redis -------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# --- Mail (verification / OTP delivery) --------------------------------------
MAIL_MAILER=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=

# --- Auth / tokens -----------------------------------------------------------
JWT_SECRET=

# --- Broadcasting (Pusher) ---------------------------------------------------
# REQUIRED whenever BROADCAST_DRIVER=pusher. AppServiceProvider::boot() refuses
# to start in any environment other than local/testing if pusher is selected
# without a key and secret. These three previously had literal default values
# committed to config/broadcasting.php in this repository's PUBLIC git history
# (audit T2-8), so they must be supplied here — and the old values must be
# treated as disclosed and rotated in the Pusher dashboard, not reused.
BROADCAST_DRIVER=null
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap2

# --- Firebase Cloud Messaging ------------------------------------------------
# Path to the service-account JSON. Inject as a secret volume; the file itself
# is git-ignored and excluded from the image build (.dockerignore).
FCM_CREDENTIALS=

# --- Seed accounts (T3-9, optional) ------------------------------------------
# Password used for all seeded TEST users (drivers/passengers). Unset = a
# random password generated per seed run and printed by the seeder. Never
# commit a real value; these accounts are test data only.
# SEED_USER_PASSWORD=
# SEED_ADMIN_PASSWORD=
# SEED_AGENT_PASSWORD=

# --- API documentation gate (T3-12) ------------------------------------------
# Comma-separated client IPs allowed to reach /docs and the swagger spec
# outside local/testing. Empty/unset = nobody outside local/testing.
# DOCS_ALLOWED_IPS=

# --- Horizon dashboard gate (RV-06) ------------------------------------------
# Shared secret required to open /horizon outside local/testing; send it as the
# X-Horizon-Token request header. Empty/unset = the dashboard is CLOSED
# everywhere outside local/testing (fail-closed: it cannot be reached at all
# until this is set).
# HORIZON_ACCESS_TOKEN=
# Optional: serve the dashboard from a non-default path (defence in depth).
# HORIZON_PATH=horizon