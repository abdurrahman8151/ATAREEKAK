<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true">

    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>app</directory>
        </include>
        <!-- T4-1: app/Http/Middleware, app/Console, app/Providers and Kernel.php
             were excluded here — precisely where the audit's highest-severity
             classes (T2-1, T3-7, boot guards, throttle keys) live. Coverage now
             counts the whole app tree; a bug in middleware can no longer hide
             behind a green coverage number. -->
    </source>

    <php>
        <env name="APP_ENV"              value="testing"/>
        <env name="DB_CONNECTION"        value="sqlite"/>
        <env name="DB_DATABASE"          value=":memory:"/>
        <env name="CACHE_DRIVER"         value="array"/>
        <env name="SESSION_DRIVER"       value="array"/>
        <env name="QUEUE_CONNECTION"     value="sync"/>
        <env name="BROADCAST_DRIVER"     value="null"/>
        <env name="MAIL_MAILER"          value="array"/>
        <env name="OTP_BYPASS_ENABLED"   value="true"/>
        <env name="WALLET_OTP_MODE"      value="testing"/>
        <env name="JWT_SECRET"           value="test_secret_key_for_testing_only_32chars"/>
        <env name="JWT_TTL"              value="600"/>
        <env name="PUSHER_APP_ID"        value=""/>
        <env name="FIREBASE_CREDENTIALS" value=""/>
        <env name="OPENROUTE_API_KEY"    value="5b3ce3597851110001cf6248bc7694410f7d4991988a0f4d3bf4c260"/>
    </php>
    <coverage>
        <report>
            <clover outputFile="coverage.xml"/>
        </report>
    </coverage>
</phpunit>
